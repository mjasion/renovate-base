{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergePr",
    "docker:enableMajor",
    "group:allDigest",
    "group:aws-cdkMonorepo",
    "group:aws-sdk-client-mockMonorepo",
    "group:aws-sdk-goMonorepo",
    "group:aws-sdk-go-v2Monorepo",
    "group:tailwindcssMonorepo",
    "group:radix-ui-primitivesMonorepo",
    "group:tanstack-formMonorepo",
    "group:tanstack-queryMonorepo",
    "group:tanstack-routerMonorepo",
    "group:tanstack-tableMonorepo",
    "group:tanstack-virtualMonorepo",
    "group:eslintMonorepo",
    "group:eslint-config-globexMonorepo",
    "group:eslint-stylisticMonorepo",
    "group:test",
    "helpers:pinGitHubActionDigests",
    "group:recommended"
  ],
  "timezone": "Europe/Warsaw",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "configMigration": true,
  "rebaseWhen": "conflicted",
  "labels": [
    "renovate"
  ],
  "argocd": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "kubernetes": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "description": "Critical security updates (patch) - immediate automerge",
      "matchUpdateTypes": ["patch"],
      "matchDatasources": ["*"],
      "vulnerabilityAlerts": {
        "enabled": true
      },
      "prPriority": 10,
      "groupName": null,
      "schedule": null,
      "separateMinorPatch": false,
      "separateMajorMinor": false,
      "automerge": true,
      "automergeType": "pr",
      "labels": ["security", "automerge", "renovate"]
    },
    {
      "groupName": "all patch dependencies",
      "groupSlug": "all-patch",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "patch"
      ]
      schedule: ["on saturday and sunday"],
    },
    {
      "description": "Group ai-sdk packages",
      "groupName": "ai-sdk packages",
      "matchPackagePatterns": [
        "^@ai-sdk/",
        "^@ai"
      ]
    },
    {
      "description": "Group Arcjet packages",
      "groupName": "arcjet packages",
      "matchPackagePatterns": [
        "^@arcjet"
      ]
    },
    {
      "matchPackagePatterns": ["^@lucide/", "^lucide-"],
      "groupName": "lucide",
      "minimumReleaseAge": "0 days",
      "schedule": ["at any time"]
    },
    {
      description: "Group ESLint ecosystem updates into one PR",
      groupName: "eslint",
      matchPackageNames: [
        "eslint",
        "@eslint/js",
        "typescript-eslint",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
      ],
    },
    {
      description: "Group BlockNote updates into one PR",
      groupName: "blocknote",
      matchPackageNames: ["/^@blocknote//"],
    },
    {
      description: "Always bump Lucide icons to latest version",
      groupName: "lucide",
      matchPackageNames: ["/^lucide/"],
      rangeStrategy: "replace",
    },
    {
      description: "Security updates - high priority",
      matchDatasources: ["npm"],
      isVulnerabilityAlert: true,
      prPriority: 10,
    },
  ]
}
